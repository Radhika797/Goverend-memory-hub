# Governed Memory Hub - Environment Variables Template
# Phase 1 Configuration

# General Application Settings
APP_NAME="Governed Memory Hub"
APP_ENV=development
LOG_LEVEL=INFO

# FastAPI API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Next.js Cockpit Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000

# PostgreSQL 16 Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=governed_memory_hub
POSTGRES_USER=hub_user
POSTGRES_PASSWORD=hub_secure_password_123

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
